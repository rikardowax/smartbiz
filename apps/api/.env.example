# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://smartbiz:smartbiz@127.0.0.1:5433/smartbiz?schema=public"
SHADOW_DATABASE_URL="postgresql://smartbiz:smartbiz@127.0.0.1:5433/smartbiz_shadow?schema=public"

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# --- Authentification --------------------------------------------------------
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=30d

# --- Agents IA (Google Gemini) ----------------------------------------------
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Authentification Google (OAuth) ----------------------------------------
GOOGLE_CLIENT_ID=
